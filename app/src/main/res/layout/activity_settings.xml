<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings / Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#203040"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your profile and pantry preferences."
            android:textSize="15sp"
            android:textColor="#606B78"
            android:paddingBottom="24dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#203040"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/editProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:autofillHints="name" />

        <EditText
            android:id="@+id/editProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:autofillHints="emailAddress" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#D9E0E8" />

        <!-- Measurement units -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Measurement Units"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#203040"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerMeasurement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:entries="@array/measurement_options"
            android:contentDescription="Measurement units" />

        <!-- Expiry reminders -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Reminders"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#203040"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <Switch
            android:id="@+id/switchExpiryReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable expiry reminders"
            android:textSize="16sp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warn me this many days before an ingredient expires:"
            android:textSize="14sp"
            android:textColor="#606B78"
            android:paddingTop="8dp" />

        <Spinner
            android:id="@+id/spinnerExpiryDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:entries="@array/expiry_warning_options"
            android:contentDescription="Expiry warning days" />

        <!-- Pantry sorting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pantry Display"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#203040"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sort pantry items by:"
            android:textSize="15sp"
            android:textColor="#606B78" />

        <Spinner
            android:id="@+id/spinnerSortOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:entries="@array/pantry_sort_options"
            android:contentDescription="Pantry sort order" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>