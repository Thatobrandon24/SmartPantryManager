<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textColor="#205C43"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make the most of the food you already have."
            android:textColor="#58665D"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Kitchen"
            android:textColor="#205C43"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Pantry"
            android:minHeight="56dp"/>

        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Ingredient"
            android:minHeight="56dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipes"
            android:minHeight="56dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnRecipeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Details"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:minHeight="56dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cook with what you have. Waste less food."
            android:textColor="#58665D"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
